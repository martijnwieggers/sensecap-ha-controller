# SenseCap Indicator — ESP32-S3, 8MB flash, 8MB OPI PSRAM

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Partitietabel
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (octal mode)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# RGB-panel met framebuffer in PSRAM: cache-instellingen tegen
# beeld-drift (underrun) als WiFi/flash-verkeer de bus deelt
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# SPIRAM_FETCH_INSTRUCTIONS/RODATA veroorzaakten StoreProhibited-bootloop in
# esp_psram_init op echte hardware; bounce-buffer in display.c dekt underrun af
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_RODATA=n
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# FreeRTOS tick 1 kHz — nodig voor vlotte LVGL-timing
CONFIG_FREERTOS_HZ=1000

# Ruimere main-task stack (JSON-parsing)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Web-config: browsers sturen bij POST >512B aan headers (Origin/Referer/UA),
# standaardlimiet geeft dan HTTP 431 "header fields too long"
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# mbedTLS-geheugen (±50 KB per TLS-verbinding) uit PSRAM: het interne RAM
# zit met LVGL-buffers + WiFi te krap, waardoor wss:// faalt met
# MBEDTLS_ERR_SSL_ALLOC_FAILED (-0x7F00)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
