# SenseCap Indicator — ESP32-S3, 8MB flash, 8MB OPI PSRAM

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Partitietabel
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (octal mode)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# RGB-panel met framebuffer in PSRAM: cache-instellingen tegen
# beeld-drift (underrun) als WiFi/flash-verkeer de bus deelt
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# FreeRTOS tick 1 kHz — nodig voor vlotte LVGL-timing
CONFIG_FREERTOS_HZ=1000

# Ruimere main-task stack (JSON-parsing)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
